# ===========================================================================
# MotoWash — variables de Docker Compose
#
#   cp .env.example .env    (y cambia al menos las tres contrasenas)
#
# Este archivo lo lee `docker compose` desde la raiz del proyecto. No lo
# confundas con backend/.env ni frontend/.env, que son para correr sin Docker.
# El .env real esta en .gitignore: nunca lo subas.
# ===========================================================================

# --- Zona horaria ----------------------------------------------------------
# Se aplica a los tres servicios. El negocio esta en Armenia, Quindio (UTC-5,
# sin horario de verano). Dejarlo en UTC descuadra en 5 horas las citas y la
# expiracion de promociones.
TZ=America/Bogota

# --- Base de datos ---------------------------------------------------------
# DB_NAME debe coincidir con el CREATE DATABASE de backend/src/config/database.sql
MYSQL_ROOT_PASSWORD=cambia_esta_password_de_root
DB_NAME=motowash_db
DB_USER=motowash
DB_PASSWORD=cambia_esta_password
# Puerto en el HOST para conectarse con un cliente MySQL externo.
# 3307 por defecto para no chocar con un MySQL ya instalado en la maquina.
DB_PORT_HOST=3307

# --- Backend ---------------------------------------------------------------
NODE_ENV=production

# Genera uno propio, largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Quien conozca este valor puede firmar un token de admin y saltarse el login
# y el 2FA por completo.
JWT_SECRET=reemplazar_por_una_cadena_aleatoria_larga
JWT_EXPIRES_IN=7d

# --- Administrador inicial -------------------------------------------------
# Se crea en el primer arranque, hasheando la contrasena en runtime. Si ese
# correo ya existe, no se toca nada: puedes cambiar la contrasena desde la
# pantalla de Perfil sin que un reinicio la revierta.
#
# Minimo 8 caracteres. El repositorio NO contiene ninguna credencial: si dejas
# estas variables vacias, no se crea administrador y nadie podra entrar.
ADMIN_EMAIL=admin@motowash.com
ADMIN_PASSWORD=cambia_esta_password_de_admin

# Puerto en el HOST para pegarle al API directamente (depuracion).
BACKEND_PORT_HOST=3000

# URL publica desde la que se sirve el frontend. Controla el origen permitido
# por CORS: tiene que ser la URL que ve el navegador, NO el nombre del
# servicio de Compose.
FRONTEND_URL=http://localhost:8080

# Numero de proxies entre el cliente y Express. Con este Compose solo hay
# nginx, asi que es 1. Si metes otro proxy o un CDN por delante, sube el
# numero. No lo pongas en `true`.
TRUST_PROXY_HOPS=1

# --- Correo (Gmail SMTP) ---------------------------------------------------
# MAIL_PASS es una "App Password" de 16 caracteres generada en
# https://myaccount.google.com/apppasswords — no la contrasena de la cuenta.
# Si se dejan vacias, la app levanta igual, pero fallan el registro de nuevos
# clientes y el 2FA (el usuario admin semilla trae el 2FA desactivado
# justamente para poder entrar sin esto).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=MotoWash <no-reply@motowash.local>

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT_HOST=8080

# OJO: se inyecta en tiempo de BUILD. Queda incrustado en el bundle, asi que
# cambiarlo obliga a reconstruir: `docker compose build frontend`.
# Relativo (/api) porque nginx hace de proxy al backend desde el mismo origen.
# Solo pon una URL absoluta si el API se sirve desde otro host o dominio.
VITE_API_URL=/api
