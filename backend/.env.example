# ---------------------------------------------------------------------------
# MotoWash — Backend
# Copia este archivo a `.env` y reemplaza los valores por los reales.
# NUNCA subas el `.env` real al repositorio.
# ---------------------------------------------------------------------------

# Puerto en el que escucha Express
PORT=3000

# development | production
NODE_ENV=development

# --- Base de datos MySQL ---------------------------------------------------
# En local: localhost. Con Docker Compose: el nombre del servicio (ej. "db").
DB_HOST=localhost
DB_PORT=3306
DB_NAME=motowash_db
DB_USER=motowash
DB_PASSWORD=cambia_esta_password

# --- JWT -------------------------------------------------------------------
# Genera uno propio, largo y aleatorio. Por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si cambias este valor, todas las sesiones activas quedan invalidadas.
JWT_SECRET=reemplazar_por_una_cadena_aleatoria_larga
JWT_EXPIRES_IN=7d

# --- Correo (Gmail SMTP) ---------------------------------------------------
# MAIL_PASS NO es la contraseña de la cuenta: es una "App Password" de 16
# caracteres que se genera en https://myaccount.google.com/apppasswords
# (requiere tener la verificacion en dos pasos activada).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=MotoWash <tu_correo@gmail.com>

# --- Frontend --------------------------------------------------------------
# URL publica desde la que se sirve el frontend. Controla el origen permitido
# por CORS, asi que tiene que ser la URL que ve el navegador (no el nombre del
# servicio de Compose).
FRONTEND_URL=http://localhost:5173
